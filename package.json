{
  "name": "space-trader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:direct-match": "VITE_BOOT_FLOW=direct_match vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p server/tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "tsc -p server/tsconfig.json && node server/dist/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.2.0",
    "playwright": "^1.59.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.4"
  }
}
